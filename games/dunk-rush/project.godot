; Engine configuration file.
; Dunk Rush — see README.md in this folder.

config_version=5

[application]

config/name="Dunk Rush"
config/description="Aim the jump, beat the shot clock, never touch the floor."
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; Matches the default arena's background so the very first frame does not flash
; a different colour before Main applies the equipped palette.
environment/defaults/default_clear_color=Color(0.055, 0.063, 0.106, 1)
; Required by Godot's Android exporter, which refuses to export without it.
textures/vram_compression/import_etc2_astc=true
