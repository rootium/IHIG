[rendering]

; GL Compatibility is the only renderer that covers web, Android and desktop
; from one export. Everything here is untextured geometry, so nothing is lost.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.024, 0.027, 0.055, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
