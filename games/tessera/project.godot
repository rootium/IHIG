; Engine configuration file.
; Tessera — see README.md in this folder.

config_version=5

[application]

config/name="Tessera"
config/description="A puzzle game in four spatial dimensions. Walls you cannot pass are only walls in the slice you happen to be standing in."
config/version="1.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Save="*res://scripts/save_data.gd"
Audio="*res://scripts/audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; sensor_landscape: the game is an isometric 3D board, so it wants the wide
; edge. Either way up is fine.
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

